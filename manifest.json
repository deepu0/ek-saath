{
  "manifest_version": 3,
  "name": "EkSaath — Group Tabs by Domain",
  "version": "1.2.0",
  "description": "Stop hunting tabs. Same domain together, duplicates shown, extras closed in one click.",
  "version_name": "1.2.0",
  "author": { "email": "support@example.com" },
  "permissions": ["tabs", "storage"],
  "incognito": "spanning",
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "EkSaath — Group tabs ek saath",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "options_page": "options.html",
  "commands": {
    "reorder-tabs": {
      "suggested_key": {
        "default": "Alt+Shift+R",
        "mac": "Alt+Shift+R"
      },
      "description": "Reorder tabs by domain"
    }
  }
}
